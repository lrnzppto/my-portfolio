---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../site.config';
import { getServices, getPublishedProjects, getTestimonials, serviceLabels } from '../lib/content';

const services = await getServices();
const projects = await getPublishedProjects();
const featuredPicks = projects.filter((p) => p.data.featured);
const featured = (featuredPicks.length ? featuredPicks : projects).slice(0, 6);
const testimonials = await getTestimonials();
const labels = await serviceLabels();
const hasWork = (id: string) => projects.some((p) => p.data.categories.some((c) => c.id === id));
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Lorenz Pepito · Available for new projects</p>
      <h1>I build it <em>and</em> make it look good.</h1>
      <p class="lede">I'm Lorenz, a Computer Engineer turned creative specialist in the Philippines. I help personal brands, coaches, creators and small businesses with websites, video, design and social media, with the technical depth to fix what's behind them too.</p>
      <div class="cta">
        <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener">Book a discovery call</a>
        <a class="btn btn-ghost" href="/work/">See my work</a>
      </div>
    </div>
  </section>

  <section id="services" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Services</p>
        <h2 id="services-title">What I can take off your plate.</h2>
        <p>Pick one, or bundle them. One person who can ship the website, edit the video and design the graphics.</p>
      </div>
      <div class="grid">
        {services.map((s, i) => (
          <article class="card">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.data.title}</h3>
            {s.data.status === 'in-development' && <span class="badge">In development</span>}
            <p>{s.data.summary}</p>
            <div class="card-links">
              {hasWork(s.id) && <a class="text-link" href={'/work/?category=' + s.id}>See related work</a>}
              <a class="text-link" href={'/services/#' + s.id}>What's included</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section aria-labelledby="work-title">
      <div class="wrap">
        <div class="section-head">
          <p class="label">Selected work</p>
          <h2 id="work-title">Proof, not promises.</h2>
          <p>The problem, what I did and what changed.</p>
        </div>
        <div class="project-grid">
          {featured.map((p) => <ProjectCard project={p} labels={labels} />)}
        </div>
        <p style="margin-top:1.75rem"><a class="text-link" href="/work/">See all work →</a></p>
      </div>
    </section>
  )}

  <section aria-labelledby="why-title">
    <div class="wrap split">
      <div>
        <div class="section-head" style="margin-bottom:1.5rem">
          <p class="label">Why work with me</p>
          <h2 id="why-title">Engineer's brain, creative's eye.</h2>
        </div>
        <p>Most virtual assistants can edit a Reel. Few can also ship a web app, untangle the tech behind a launch or set up the tools your business runs on.</p>
        <p>I have a Computer Engineering background and over three years of professional software development, including leading a team that built mobile and web apps. Today I put that same discipline into creative work, so you get one reliable partner instead of handing your project between five freelancers.</p>
        <p><a class="text-link" href="/about/">More about me →</a></p>
      </div>
      <div class="facts">
        <div class="fact"><strong>3+ years</strong><span>Professional software development</span></div>
        <div class="fact"><strong>Team lead</strong><span>Led engineers on mobile and web apps</span></div>
        <div class="fact"><strong>AZ-104 · AZ-204</strong><span>Microsoft Azure certified</span></div>
      </div>
    </div>
  </section>

  {testimonials.length > 0 && (
    <section aria-labelledby="quotes-title">
      <div class="wrap">
        <div class="section-head">
          <p class="label">Kind words</p>
          <h2 id="quotes-title">What clients say.</h2>
        </div>
        <div class="quotes">
          {testimonials.map((t) => (
            <figure class="quote">
              <blockquote><p>{t.data.quote}</p></blockquote>
              <figcaption>
                {t.data.photo && <img src={t.data.photo} alt="" loading="lazy" width="40" height="40" />}
                <span><strong>{t.data.link ? <a href={t.data.link} target="_blank" rel="noopener">{t.data.name}</a> : t.data.name}</strong>{t.data.role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

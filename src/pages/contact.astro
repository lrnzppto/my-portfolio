---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
import { getServices } from '../lib/content';

const services = await getServices();
const SUPABASE_URL = site.supabase.url;
const SUPABASE_KEY = site.supabase.publishableKey;
const REPLY_TIME = site.replyTime;
const BOOKING_URL = site.bookingUrl;
const budgets = [
  ['under-500', 'Under $500'],
  ['500-1500', '$500 to $1,500'],
  ['1500-5000', '$1,500 to $5,000'],
  ['5000-plus', '$5,000+'],
  ['not-sure', 'Not sure yet'],
];
const timelines = [
  ['asap', 'As soon as possible'],
  ['1-month', 'Within a month'],
  ['1-3-months', 'In 1 to 3 months'],
  ['flexible', 'Flexible'],
];
---
<Base title="Contact" description="Book a free discovery call with Lorenz Pepito or send a project inquiry. Replies within one business day.">
  <section class="page-head">
    <div class="wrap">
      <p class="label">Contact</p>
      <h1>Have a project in mind?</h1>
      <p class="lede">Tell me what you're working on, or book a call if you'd rather talk. You'll hear back {site.replyTime}.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap split">
      <div>
        <form class="form" id="inquiry-form" novalidate>
          <div class="row-2">
            <div class="field">
              <label for="f-name">Name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="err-name" />
              <p class="field-error" id="err-name"></p>
            </div>
            <div class="field">
              <label for="f-email">Email</label>
              <input id="f-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="err-email" />
              <p class="field-error" id="err-email"></p>
            </div>
          </div>
          <div class="field">
            <label for="f-business">Business or website <span class="hint">(optional)</span></label>
            <input id="f-business" name="business" type="text" autocomplete="organization" maxlength="200" />
          </div>
          <fieldset class="field" aria-describedby="err-services">
            <legend>Services you're interested in</legend>
            <div class="checks">
              {services.map((s) => (
                <label><input type="checkbox" name="services" value={s.id} /> {s.data.title}</label>
              ))}
            </div>
            <p class="field-error" id="err-services"></p>
          </fieldset>
          <div class="field">
            <label for="f-description">About your project</label>
            <textarea id="f-description" name="description" maxlength="5000" required aria-describedby="err-description" placeholder="What do you need, who is it for, and what does success look like?"></textarea>
            <p class="field-error" id="err-description"></p>
          </div>
          <div class="row-2">
            <div class="field">
              <label for="f-budget">Budget range <span class="hint">(optional)</span></label>
              <select id="f-budget" name="budget">
                <option value="">Choose a range</option>
                {budgets.map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="f-timeline">Timeline <span class="hint">(optional)</span></label>
              <select id="f-timeline" name="timeline">
                <option value="">Choose a timeline</option>
                {timelines.map(([v, l]) => <option value={v}>{l}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="f-source">How did you find me? <span class="hint">(optional)</span></label>
            <input id="f-source" name="source" type="text" maxlength="200" />
          </div>
          <div class="hp" aria-hidden="true">
            <label for="f-website-confirm">Leave this field empty</label>
            <input id="f-website-confirm" name="website_confirm" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn btn-primary" type="submit" id="f-submit" style="justify-self:start">Send inquiry</button>
          <p class="form-status" id="f-status" role="status" aria-live="polite"></p>
          <p class="muted" style="font-size:.85rem;margin:0">Your details are only used to reply to your inquiry. <a href="/privacy/">Privacy</a></p>
        </form>

        <div class="success-panel" id="inquiry-success" hidden tabindex="-1">
          <h2>Thanks! Your inquiry is in.</h2>
          <p id="success-text"></p>
          <p style="margin:0">Want to talk sooner? <a class="text-link" href={site.bookingUrl} target="_blank" rel="noopener">Book a discovery call</a>.</p>
        </div>
      </div>

      <aside class="contact-side" aria-label="Other ways to reach me">
        <div class="card">
          <h2>Prefer to talk?</h2>
          <p>Book a free discovery call. Available times show in your own time zone, and you get a calendar invite right away.</p>
          <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener" style="justify-self:start">Book a call</a>
        </div>
        <div class="card">
          <h2>Other channels</h2>
          {site.email && <p>Email: <a class="text-link" href={'mailto:' + site.email}>{site.email}</a></p>}
          <ul class="chips">
            {site.socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener me" style="text-decoration:none">{s.label}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_KEY, REPLY_TIME, BOOKING_URL }}>
  (function () {
    var form = document.getElementById('inquiry-form');
    var submit = document.getElementById('f-submit');
    var status = document.getElementById('f-status');
    var success = document.getElementById('inquiry-success');
    var startedAt = Date.now();

    // Pre-select a service from ?service=<id> (used by "Start a similar project").
    var wanted = new URLSearchParams(location.search).get('service');
    if (wanted) {
      var box = form.querySelector('input[name="services"][value="' + CSS.escape(wanted) + '"]');
      if (box) box.checked = true;
    }

    function setError(id, message, control) {
      var el = document.getElementById('err-' + id);
      if (el) el.textContent = message || '';
      if (control) control.setAttribute('aria-invalid', message ? 'true' : 'false');
    }

    function setStatus(text, isError) {
      status.textContent = text;
      status.classList.toggle('error', !!isError);
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var f = form.elements;
      var data = {
        name: f.name.value.trim(),
        email: f.email.value.trim(),
        business: f.business.value.trim() || null,
        services: Array.prototype.filter.call(form.querySelectorAll('input[name="services"]'), function (c) { return c.checked; }).map(function (c) { return c.value; }),
        description: f.description.value.trim(),
        budget: f.budget.value || null,
        timeline: f.timeline.value || null,
        source: f.source.value.trim() || null,
        time_zone: (Intl.DateTimeFormat().resolvedOptions().timeZone || null),
      };

      // Inline validation: flag the exact field, keep everything the visitor typed.
      var firstInvalid = null;
      function check(id, control, ok, message) {
        setError(id, ok ? '' : message, control);
        if (!ok && !firstInvalid) firstInvalid = control;
      }
      check('name', f.name, data.name.length >= 1 && data.name.length <= 100, 'Please enter your name.');
      check('email', f.email, /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(data.email) && data.email.length <= 254, 'Please enter a valid email address, like name@example.com.');
      check('services', form.querySelector('input[name="services"]'), data.services.length > 0, 'Choose at least one service.');
      check('description', f.description, data.description.length >= 1 && data.description.length <= 5000, 'Tell me a little about your project.');
      if (firstInvalid) {
        setStatus('Please fix the highlighted fields.', true);
        firstInvalid.focus();
        return;
      }

      function showSuccess() {
        form.hidden = true;
        document.getElementById('success-text').textContent =
          'Thanks, ' + data.name + '. I will reply to ' + data.email + ' ' + REPLY_TIME + ' with next steps.';
        success.hidden = false;
        success.focus();
      }

      // Spam protection: bots fill the hidden field or submit instantly. Pretend success, send nothing.
      if (f.website_confirm.value || Date.now() - startedAt < 3000) { showSuccess(); return; }

      submit.disabled = true;
      setStatus('Sending…');
      fetch(SUPABASE_URL + '/rest/v1/inquiries', {
        method: 'POST',
        headers: { apikey: SUPABASE_KEY, 'Content-Type': 'application/json', Prefer: 'return=minimal' },
        body: JSON.stringify(data),
      })
        .then(function (res) {
          if (!res.ok) throw new Error('HTTP ' + res.status);
          showSuccess();
        })
        .catch(function (err) {
          console.error('Inquiry failed:', err);
          setStatus('Sorry, that did not send. Your details are still here, so please try again, or book a call instead.', true);
        })
        .finally(function () { submit.disabled = false; });
    });
  })();
</script>
